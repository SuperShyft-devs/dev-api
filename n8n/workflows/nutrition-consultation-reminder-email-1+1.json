      "name": "Validate Email Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nreturn body.members\n  .filter((member) => member.session_details && member.session_details.want !== false)\n  .map((member) => ({\n    json: {\n      notification_id: notificationId,\n      first_name: member.first_name || 'Participant',\n      last_name: member.last_name || '',\n      email: member.email || '',\n      phone: member.phone || '',\n      session_details: {\n        want: Boolean(member.session_details.want),\n        date: member.session_details.date || '',\n        slot: member.session_details.slot || '',\n        expert_type: member.session_details.expert_type || 'nutritionist',\n        cabin: member.session_details.cabin || ''\n      }\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4992,
        2640
      ],
      "id": "ncre11-split",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst consultationTime = (member.session_details?.slot || '').trim();\nconst body = `Hello ${name},\\n\\nJust a reminder that your Supershyft nutrition consultation is scheduled for tomorrow.\\n\\nTime: ${consultationTime}\\n\\nPlease be available at the scheduled time.\\n\\nWe look forward to speaking with you.\\n\\nWarm regards,\\nTeam Supershyft`;\nreturn { json: { notification_id: member.notification_id, to: member.email, subject: 'Reminder: Your Nutrition Consultation is Tomorrow', body } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5216,
        2640
      ],
      "id": "ncre11-prepare",
      "name": "Prepare Nutrition Reminder Email"
    },
    {
      "parameters": {
        "fromEmail": "support@supershyft.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
