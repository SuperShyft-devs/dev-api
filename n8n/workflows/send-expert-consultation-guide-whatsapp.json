      "id": "ecg-validate-0001",
      "name": "Validate WhatsApp Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\n\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || 'Doctor',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || ''\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4960,
        2688
      ],
      "id": "ecg-split-0001",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Doctor').trim();\n\nlet phone = String(member.phone || '').replace(/\\D/g, '');\nif (phone.length === 10) {\n  phone = '91' + phone;\n}\n\nconst campConsultationsUrl = 'https://admin.supershyft.com/experts/portal/camp-consultations';\n\nconst message =\n`camp13,${name},Welcome to SuperShyft Expert Portal.,Use the portal to review camp consultations and manage participant sessions.,Open your camp consultations using the link below.,${campConsultationsUrl},Please review your consultations and let us know if you need any assistance. Thanks!`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    phone,\n    message\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5184,
        2688
      ],
