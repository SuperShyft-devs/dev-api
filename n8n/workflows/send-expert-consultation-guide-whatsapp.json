    {
      "parameters": {
        "content": "## Send Expert Consultation Guide WhatsApp\nPlain-text WhatsApp (no PDF / medialink) — same pattern as pretest-whatsapp.\nGuides doctors/experts to manage consultations in the Expert Portal.\nExpects: { notification_id, members: [{ first_name, last_name, email, phone }] }\n\nSuggested notification_services row:\n  service_key: expert-consultation-guide-whatsapp\n  webhook_path: send-expert-consultation-guide-whatsapp-v1\n  channel: whatsapp\n\nCamp consultations: https://admin.supershyft.com/experts/portal/camp-consultations",
        "height": 640,
        "width": 2144
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4432,
        2576
      ],
