    {
      "parameters": {
        "content": "## Nvidia Consultation Confirmed Email\nSends doctor consultation booking confirmation email to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    session_details: { want, date, slot, expert_type, cabin? }\n  }],\n  engagement_id?: number\n}\n\nNotification service must have require_session_details enabled.",
        "height": 560,
        "width": 1984
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4432,
        2528
      ],
      "typeVersion": 1,
      "id": "ece01-node-0000-221866cb",
      "name": "Sticky Note Nvidia Confirmed Email"
    },
