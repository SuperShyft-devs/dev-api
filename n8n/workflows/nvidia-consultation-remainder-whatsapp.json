  "nodes": [
    {
      "parameters": {
        "content": "## Nvidia Consultation Remainder WhatsApp\nSends camp17 day-of doctor consultation reminder WhatsApp to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    session_details: { want, date, slot, expert_type, cabin? }\n  }],\n  engagement_id?: number\n}\n\nNotification service must have require_session_details enabled.",
        "height": 640,
        "width": 2336
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4448,
        5600
      ],
      "typeVersion": 1,
      "id": "erw01-node-0000-87094608",
      "name": "Sticky Note Nvidia Remainder WhatsApp"
    },
