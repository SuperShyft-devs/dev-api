      "name": "Sticky Blood Report Ready Email 1+1"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-blood-report-email-1+1-v1",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
