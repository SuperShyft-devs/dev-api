    {
      "parameters": {
        "content": "## Consultation Remainder Email\nSends day-of consultation reminder email to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    session_details: { want, date, slot, expert_type }\n  }],\n  engagement_id?: number\n}\n\nEach member carries its own session_details (API attaches per user on dispatch).",
        "height": 560,
        "width": 1984
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4432,
        1856
      ],
      "typeVersion": 1,
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Sticky Note Consultation Remainder"
    },
