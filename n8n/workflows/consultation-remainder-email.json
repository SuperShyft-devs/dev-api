      ],
      "id": "d3e4f5a6-b7c8-9012-def0-234567890123",
      "name": "Validate Email Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\n\nreturn body.members\n  .filter((member) => member.session_details && member.session_details.want !== false)\n  .map((member) => ({\n    json: {\n      notification_id: notificationId,\n      first_name: member.first_name || 'Participant',\n      last_name: member.last_name || '',\n      email: member.email || '',\n      phone: member.phone || '',\n      session_details: {\n        want: Boolean(member.session_details.want),\n        date: member.session_details.date || '',\n        slot: member.session_details.slot || '',\n        expert_type: member.session_details.expert_type || 'doctor'\n      }\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4992,
        1968
      ],
      "id": "e4f5a6b7-c8d9-0123-ef01-345678901234",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst session = member.session_details || {};\nconst expertType = (session.expert_type || 'doctor').trim();\nconst expertLabel = expertType\n  .replace(/_/g, ' ')\n  .replace(/\\b\\w/g, (char) => char.toUpperCase());\nconst slot = (session.slot || '').trim();\nconst slotLine = slot ? `\\n\\nScheduled time: ${slot}` : '';\n\nconst body = `Hi ${name},\\n\\nThis is a reminder that your ${expertLabel} consultation is scheduled for today.${slotLine}\\n\\nPlease keep your phone available during the scheduled time and have your Bio-AI Health Report accessible so the discussion can be as productive as possible.\\n\\nWe look forward to helping you take the next step toward better health.\\n\\nWarm regards,\\nSupport Team\\nSupershyft`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    to: member.email,\n    subject: 'Reminder - Your Consultation is Today',\n    body\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5216,
        1968
      ],
      "id": "f5a6b7c8-d9e0-1234-f012-456789012345",
      "name": "Prepare Consultation Remainder Email"
    },
    {
      "parameters": {
        "fromEmail": "support@supershyft.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
