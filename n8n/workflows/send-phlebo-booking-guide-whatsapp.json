    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nconst engagementId = body.engagement_id ?? null;\n\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    engagement_id: engagementId,\n    first_name: member.first_name || 'Phlebotomist',\n    phone: member.phone || ''\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10112,
        912
      ],
      "id": "a7b8c9d0-e1f2-3456-0123-567890123456",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Phlebotomist').trim();\n\nlet phone = String(member.phone || '').replace(/\\D/g, '');\nif (phone.length === 10) phone = '91' + phone;\n\nconst BOOKING_GUIDE_URL = 'https://api.supershyft.com/media/documents/SuperShyft_Booking_Guide.pdf';\n\nconst engagementId = member.engagement_id;\nconst hasEngagement = engagementId !== null && engagementId !== undefined && engagementId !== '' && Number(engagementId) > 0;\nconst consoleUrl = hasEngagement\n  ? `https://admin.supershyft.com/engagements/${engagementId}/console`\n  : 'https://admin.supershyft.com/engagements/console';\n\nconst message =\n`camp15,${name},\nWelcome! 👋,\nWe have shared a quick step-by-step guide to help you create bookings using the SuperShyft Engagement Console. Please refer to the attached guide before creating your first booking.,\nYou can access your Engagement Console using the link below:,\n${consoleUrl},\nPlease go through the guide and let us know if you have any questions or need any assistance.,\nThanks!`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    booking_guide_url: BOOKING_GUIDE_URL,\n    first_name: name,\n    phone,\n    message\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
