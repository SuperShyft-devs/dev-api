    {
      "parameters": {
        "content": "## Welcome Booking WhatsApp 1+1 (camp17)\nSends preventive health assessment booking confirmation WhatsApp to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    session_details: { want, date, slot, expert_type, cabin? }\n  }],\n  engagement_id?: number\n}\n\nNotification service must have require_session_details enabled.\nMaps: date → Collection_Date, slot → Collection_Time, cabin → Cabin_Name.",
        "height": 640,
        "width": 2336
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4448,
        4800
      ],
      "typeVersion": 1,
      "id": "wbw01-node-0000-sticky",
