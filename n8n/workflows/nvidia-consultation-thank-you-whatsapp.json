      "id": "etw01-node-0002-87404b1c",
      "name": "Validate WhatsApp Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\n\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || 'Participant',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    external_link: member.external_link\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5008,
        6480
      ],
      "id": "etw01-node-0003-9783eaa0",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst feedbackLink = (member.external_link || '').trim();\n\nlet phone = String(member.phone || '').replace(/\\D/g, '');\nif (phone.length === 10) phone = '91' + phone;\n\nconst message = `camp17,${name},Thank you for attending your checkup and consultation with our doctor.,We hope the session helped you better understand your Bio-AI Health Report and your overall health status.,We would love to hear your thoughts on your overall experience with Supershyft so far.,Your feedback helps us continue shaping a better preventive health journey for you.,You can check the details below for your convenience.,${feedbackLink},Thanks for taking a moment to read this message.,Regards,Team Supershyft`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    phone,\n    message\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5264,
        6480
      ],
