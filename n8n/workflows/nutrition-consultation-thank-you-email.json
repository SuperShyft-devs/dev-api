    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst feedbackLink = (member.external_link || 'https://app.supershyft.com').trim();\n\nconst body = `Hi ${name},\\n\\nThank you for attending your consultation with our doctor. We hope the session provided you with a clearer understanding of your Bio-AI Health Report, your current health status, and the recommendations discussed during the consultation.\\n\\nWe would love to hear your thoughts on your overall experience with Supershyft so far.\\nYour feedback helps us continue shaping a better preventive health journey for you and every member of our community.\\nYou can share your feedback using the link below.\\n${feedbackLink}\\n\\nShould you have any additional questions or require further assistance, please don't hesitate to reach out to us.\\n\\nWarm regards,\\nTeam Supershyft`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    to: member.email,\n    subject: 'Thank You for Attending Your Nutrition Consultation',\n    body\n  }\n};"
      },
