        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\n\nconst body = `Dear ${name},\n\nYou will receive access to book your doctor consultation through the Supershyft app. The entire consultation process will be managed through the app, where you can select your preferred cabin, date, and time slot.\n\nYour HR team will reach out to you once the booking option is released on the app.\n\nRegards,\nTeam Supershyft`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    to: member.email,\n    subject: 'Doctor Consultation Booking on Supershyft App',\n    body\n  }\n};"
      },
