        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst bookingLink = (member.external_link || '').trim();\n\nconst body = `Hi ${name},\\n\\nYour health assessment has been completed and you are now eligible for a consultation with one of our doctors.\\n\\nThe consultation will help you better understand your report findings and develop a personalized action plan.\\n\\nPlease book a convenient slot below:\\n${bookingLink}\\n\\nWarm regards,\\nTeam Supershyft`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    to: member.email,\n    subject: 'Book Your doctor Consultation',\n    body\n  }\n};"
      },
