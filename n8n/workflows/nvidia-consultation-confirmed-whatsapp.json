      "parameters": {
        "content": "## Nvidia Consultation Confirmed WhatsApp\nSends camp17 eye checkup + doctor consultation confirmation WhatsApp to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    session_details: { want, date, slot, expert_type }\n  }],\n  engagement_id?: number\n}\n\nNotification service must have require_session_details enabled.",
