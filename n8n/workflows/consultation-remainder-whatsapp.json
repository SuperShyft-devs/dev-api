    {
      "parameters": {
        "content": "## Consultation Remainder WhatsApp\nSends camp17 day-of consultation reminder WhatsApp to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{ first_name, last_name, email, phone }],\n  engagement_id?: number\n}\n\nStatic today reminder copy; session_details may be present from the API but is not required by this workflow.",
        "height": 640,
        "width": 2336
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4448,
        5600
      ],
      "typeVersion": 1,
      "id": "cr01-sticky-note-0001",
      "name": "Sticky Note Consultation Remainder WhatsApp"
    },
