      "id": "ncba-validate-0001",
      "name": "Validate Nvidia Booking Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst pd = body.participant_details || {};\n\n// Prefer top-level session_details; fall back to first member if present\nconst sessionDetails = body.session_details\n  || (Array.isArray(body.members) && body.members[0] && body.members[0].session_details)\n  || {};\n\nconst date = (sessionDetails.date || '').toString().trim();\nconst slot = (sessionDetails.slot || '').toString().trim();\nconst cabin = (sessionDetails.cabin || '').toString().trim();\n\nif (!date || !slot) {\n  return [{\n    json: {\n      notification_id: body.notification_id,\n      status: 'failed',\n      message: 'Payload validation failed: session_details.date and session_details.slot are required',\n      skip_dispatch: true\n    }\n  }];\n}\n\nconst userIdRaw = pd.participant_user_id;\nconst userId = Number(userIdRaw);\nif (!Number.isFinite(userId) || userId <= 0) {\n  return [{\n    json: {\n      notification_id: body.notification_id,\n      status: 'failed',\n      message: 'Payload validation failed: participant_details.participant_user_id is required',\n      skip_dispatch: true\n    }\n  }];\n}\n\nconst forwardedSessionDetails = {\n  want: sessionDetails.want !== false,\n  date,\n  slot,\n  expert_type: sessionDetails.expert_type || 'doctor'\n};\nif (cabin) forwardedSessionDetails.cabin = cabin;\n\n// members (OAs) are intentionally ignored — only notify the participant\nreturn [{\n  json: {\n    notification_id: body.notification_id,\n    engagement_id: body.engagement_id,\n    user_ids: [userId],\n    session_details: forwardedSessionDetails,\n    status: 'sent',\n    message: 'participant-only dispatch (OA members skipped)',\n    skip_dispatch: false\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8576,
        2800
      ],
