  "nodes": [
    {
      "parameters": {
        "content": "## Nvidia Consultation Booking Alert\nSkips OA member alerts. Only notifies the participant by dispatching:\n- nvidia-consultation-confirmed-whatsapp-v1\n- nvidia-consultation-confirmed-email-v1\n\nExpects: {\n  notification_id, engagement_id,\n  participant_details: { participant_user_id, ... },\n  session_details: { date, slot, expert_type?, cabin? },\n  members?: []  // ignored — not notified\n}",
        "height": 720,
        "width": 2200
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        7872,
        2432
      ],
      "typeVersion": 1,
      "id": "ncba-sticky-0001",
      "name": "Sticky Note Nvidia Booking Alert"
    },
    {
