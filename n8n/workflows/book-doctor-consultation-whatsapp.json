      "id": "bd01-validate-0001",
      "name": "Validate WhatsApp Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\n\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || 'Participant',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    external_link: member.external_link\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5008,
        4080
      ],
      "id": "bd01-split-0001",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst bookingLink = (member.external_link || '').trim();\n\nlet phone = String(member.phone || '').replace(/\\D/g, '');\nif (phone.length === 10) phone = '91' + phone;\n\nconst message = `camp17,${name},Your Bio-AI Health Assessment has been completed and your consultation is now available for booking.,Choose a convenient time slot that works best for your schedule through the booking link below.,This consultation will help you understand your health risks and create an actionable plan.,You can check the details below for your convenience,${bookingLink},Thanks for taking a moment to read this message`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    phone,\n    message\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5264,
        4080
      ],
      "id": "bd01-prepare-0001",
      "name": "Prepare Book Consultation WhatsApp"
    },
