    {
      "parameters": {
        "content": "## Book Doctor Consultation WhatsApp\nSends camp17 consultation booking WhatsApp to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    external_link\n  }]\n}\n\nNotification service must have require_external_link enabled (API attaches booking URL per member).",
        "height": 640,
        "width": 2336
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4448,
        4000
      ],
      "typeVersion": 1,
