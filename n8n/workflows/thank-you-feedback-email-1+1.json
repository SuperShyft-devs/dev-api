      "id": "tyfe11-validate",
      "name": "Validate Email Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || 'Participant',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    blood_report_url: member.blood_report_url || '',\n    external_link: member.external_link || '',\n    session_details: member.session_details || null\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4992,
        2640
      ],
      "id": "tyfe11-split",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst feedbackLink = (member.external_link || '').trim() || 'https://g.page/r/CXgei8jRXMKUEAI/review';\nconst body = `Hello ${name},\\n\\nThank you for completing your Supershyft health journey with us.\\n\\nWe hope the experience helped you better understand your health and take meaningful steps towards prevention.\\n\\nWe would love to hear your feedback. Your experience helps us improve and serve our community better.\\n\\nShare your feedback:\\n${feedbackLink}\\n\\nThank you for choosing Supershyft.\\n\\nWarm regards,\\nTeam Supershyft`;\nreturn { json: { notification_id: member.notification_id, to: member.email, subject: 'Thank You for Choosing Supershyft', body } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5216,
        2640
      ],
      "id": "tyfe11-prepare",
      "name": "Prepare Thank You Feedback Email"
    },
    {
      "parameters": {
        "fromEmail": "support@supershyft.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        5456,
        2640
      ],
      "id": "tyfe11-send",
      "name": "Send Thank You Feedback Email",
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "webhookId": "tyfe11-smtp",
      "credentials": {
        "smtp": {
          "id": "eCub7Y6RwBvqnurK",
          "name": "SMTP account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
