      "id": "c4d5e6f7-a8b9-0123-def0-234567890125",
      "name": "Validate Email Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\n\nreturn body.members\n  .filter((member) => member.session_details && member.session_details.want !== false)\n  .map((member) => ({\n    json: {\n      notification_id: notificationId,\n      first_name: member.first_name || 'Participant',\n      last_name: member.last_name || '',\n      email: member.email || '',\n      phone: member.phone || '',\n      session_details: {\n        want: Boolean(member.session_details.want),\n        date: member.session_details.date || '',\n        slot: member.session_details.slot || '',\n        expert_type: member.session_details.expert_type || 'doctor'\n      }\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4992,
        2640
      ],
      "id": "d5e6f7a8-b9c0-1234-ef01-345678901235",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst consultationDate = (member.session_details?.date || '').trim();\nconst consultationTime = (member.session_details?.slot || '').trim();\n\nconst body = `Hi ${name},\\n\\nYour doctor consultation has been successfully scheduled.\\n\\nDate: ${consultationDate}\\nTime: ${consultationTime}\\n\\nPlease keep your Bio-AI Health Report accessible during the session so your doctor can walk you through the findings in detail.\\n\\nIf you need to reschedule, please inform us in advance.\\n\\nWarm regards,\\nTeam Supershyft`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    to: member.email,\n    subject: 'Your Doctor Consultation is Confirmed',\n    body\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5216,
        2640
      ],
      "id": "e6f7a8b9-c0d1-2345-f012-456789012346",
      "name": "Prepare Consultation Confirmed Email"
    },
    {
