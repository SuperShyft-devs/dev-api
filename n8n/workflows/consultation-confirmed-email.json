      "parameters": {
        "content": "## Consultation Confirmed Email\nSends consultation booking confirmation email to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    session_details: { want, date, slot, expert_type }\n  }],\n  engagement_id?: number\n}\n\nNotification service must have require_session_details enabled.",
        "height": 560,
        "width": 1984
      },
