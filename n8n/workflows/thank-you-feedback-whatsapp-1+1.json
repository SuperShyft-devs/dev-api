    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || 'Participant',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    blood_report_url: member.blood_report_url || '',\n    external_link: member.external_link || '',\n    session_details: member.session_details || null\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5008,
        4880
      ],
      "id": "tyfw11-split",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst feedbackLink = (member.external_link || '').trim() || 'https://g.page/r/CXgei8jRXMKUEAI/review';\nlet phone = String(member.phone || '').replace(/\\D/g, '');\nif (phone.length === 10) phone = '91' + phone;\nconst message = `camp17,${name},Thank you for completing your Supershyft health journey with us.,We hope the experience helped you better understand your health and take meaningful steps towards prevention.,We would love to hear your feedback. Your experience helps us improve and serve our community better.,Share your feedback here: ${feedbackLink},Thank you for choosing Supershyft.,Regards,Team Supershyft`;\nreturn { json: { notification_id: member.notification_id, phone, message } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5264,
        4880
      ],
