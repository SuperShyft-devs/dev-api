    {
      "parameters": {
        "jsCode": "// Fan out: one output item per member\nconst body = $input.first().json.body;\nconst notificationId = body.notification_id;\n\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || 'Participant',\n    last_name: member.last_name || '',\n    email: member.email,\n    phone: member.phone || '',\n    external_link: member.external_link\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4944,
        960
      ],
      "id": "ete01-node-0000-6d4cbca9",
      "name": "Split Members"
    },
    {
      "parameters": {
        "content": "## Nvidia Consultation Thank You Email\nSends a post doctor consultation thank you email to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    external_link\n  }]\n}\n\nNotification service must have require_external_link enabled (API attaches feedback URL per member).",
        "height": 640,
        "width": 1848
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
