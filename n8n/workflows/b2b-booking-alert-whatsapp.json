      "id": "b2ba-validate-0001",
      "name": "Validate B2B Booking Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst pd = body.participant_details || {};\n\nconst userIdRaw = pd.participant_user_id;\nconst userId = Number(userIdRaw);\nif (!Number.isFinite(userId) || userId <= 0) {\n  return [{\n    json: {\n      notification_id: body.notification_id,\n      status: 'failed',\n      message: 'Payload validation failed: participant_details.participant_user_id is required',\n      skip_dispatch: true\n    }\n  }];\n}\n\n// members (OAs/internal team) are intentionally ignored — only notify the participant\nreturn [{\n  json: {\n    notification_id: body.notification_id,\n    engagement_id: body.engagement_id,\n    user_ids: [userId],\n    status: 'sent',\n    message: 'participant-only dispatch (internal team skipped)',\n    skip_dispatch: false\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8576,
        2800
      ],
