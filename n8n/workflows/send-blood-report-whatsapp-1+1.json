    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || 'Participant',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    blood_report_url: member.blood_report_url || '',\n    external_link: member.external_link || '',\n    session_details: member.session_details || null\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5008,
        4880
      ],
      "id": "sbrw11-split",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst reportUrl = (member.blood_report_url || '').trim();\nlet phone = String(member.phone || '').replace(/\\D/g, '');\nif (phone.length === 10) phone = '91' + phone;\nconst message = `camp17,${name},Your Supershyft Blood Test Report is now ready.,The report provides a detailed view of your blood biomarkers and key clinical parameters.,You can check your report here: ${reportUrl},Your Bio-AI Health Report will help you understand these results in greater detail.`;\nreturn { json: { notification_id: member.notification_id, phone, message } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5264,
        4880
      ],
