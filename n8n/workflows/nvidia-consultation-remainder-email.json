      ],
      "id": "ere01-node-0005-7548d3c6",
      "name": "Send Nvidia Remainder Email",
      "webhookId": "ere01-wh-49242360f508",
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "credentials": {
        "smtp": {
          "id": "eCub7Y6RwBvqnurK",
          "name": "SMTP account"
        }
      },
      "onError": "continueErrorOutput"
    },
