                "singleValue": true
              }
            },
            {
              "id": "ere01-cond-f339670c",
              "leftValue": "={{ $json.body.members.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "ere01-cond-faf24559",
              "leftValue": "={{ $json.body.members[0].session_details }}",
              "rightValue": "",
              "operator": {
