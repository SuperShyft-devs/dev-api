{
  "nodes": [
    {
      "parameters": {
        "content": "## Nvidia Consultation Remainder Email\nSends day-of doctor consultation reminder email to each member.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    session_details: { want, date, slot, expert_type, cabin? }\n  }],\n  engagement_id?: number\n}\n\nEach member carries its own session_details (API attaches per user on dispatch).",
        "height": 560,
        "width": 1984
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4432,
        1856
      ],
      "typeVersion": 1,
      "id": "ere01-node-0000-222b6d8d",
      "name": "Sticky Note Nvidia Remainder Email"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nvidia-consultation-remainder-email-v1",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
