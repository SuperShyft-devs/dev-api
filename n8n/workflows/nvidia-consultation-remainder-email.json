        4544,
        2080
      ],
      "id": "ere01-node-0001-094d0409",
      "name": "Nvidia Consultation Remainder Email",
      "webhookId": "ere01-wh-5ad45f799680"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "ere01-cond-eda3ac7a",
              "leftValue": "={{ $json.body.notification_id }}",
              "rightValue": 0,
              "operator": {
